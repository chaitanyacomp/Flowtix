# Local database backups (see BACKUP_STORAGE_DIR / default ERP_DATA/backups)
ERP_DATA/

# FT-DEP-001 Batch 1 — generated release packages (rebuild via deployment\create-release.bat)
/release/

# FT-DEP-001 Batch 2 — local runtime data (dev layout mirrors client shared/ + logs/)
/shared/
/logs/

# FT-DEP-001 Batch 4 — local DB dumps (never commit)
/backups/

# FT-DEP-001 Batch 3 — local esbuild resolve layout (synced from deployment/vendor at build time)
/deployment/node_modules/

/_lab_ft_home/
/_lab_m2_verify/
/_lab_m3_certify/
/_lab_setup9/
/customer-media/

# FT-DEP-001 Batch 8 — optional WinSW install tree at FT home (dev/lab)
/service/

# FT-DEP-001 Batch 10 — Inno Setup build output
/deployment/installer/output/

# Lab / auth certification scratch (never commit)
/_lab_auth_cert/
/artifacts/auth-cert-server.err.log
/artifacts/auth-cert-server.out.log
/artifacts/*.log
/debug.log

# TypeScript incremental build info
**/tsconfig.tsbuildinfo
frontend/tsconfig.tsbuildinfo

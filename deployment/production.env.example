# =============================================================================
# Flowtix ERP — Production environment template (FT-DEP-001 Batch 2)
# =============================================================================
# Copy to:  <FT_ERP_HOME>\shared\.env   (LAN deployment)
# Or:       backend\.env               (development only)
#
# NEVER commit a real .env with secrets.
# Application fails fast at startup if required variables are missing.
# =============================================================================

# --- Required (all environments) ---------------------------------------------

# MySQL connection string. Do not expose MySQL beyond localhost on LAN servers.
DATABASE_URL="mysql://erp_user:CHANGE_ME@127.0.0.1:3306/flowtix_erp"

# --- Required in production (NODE_ENV=production) -----------------------------

# Access-token signing secret. Use a long random string (min 16 characters).
JWT_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_SECRET"

# --- Core runtime ------------------------------------------------------------

# development | production | test
NODE_ENV=production

# HTTP listen port (LAN clients use http://<server-ip>:PORT)
PORT=4000

# Optional bind host (default: all interfaces when unset by Node listen)
# HOST=0.0.0.0

# --- Runtime folders (FT-DEP-001) --------------------------------------------

# Preferred: set FT_ERP_HOME to the client install root (contains shared/, logs/, releases/).
# FT_ERP_HOME=C:\FT-ERP

# Override shared data directory (default: <FT_ERP_HOME>\shared or <repo>\shared)
# SHARED_DIR=C:\FT-ERP\shared

# Override log directory (default: <FT_ERP_HOME>\logs or <repo>\logs)
# LOG_DIR=C:\FT-ERP\logs

# Optional explicit VERSION.txt path (Batch 1 release metadata)
# VERSION_FILE=C:\FT-ERP\current\VERSION.txt

# --- Optional: branding / backups (existing product features) ----------------

# Company logo/signature disk root (default: <repo>\ERP_DATA\branding)
# BRANDING_STORAGE_DIR=C:\FT-ERP\shared\branding

# Database backup storage (Admin → Backup & Restore)
# BACKUP_STORAGE_DIR=C:\FT-ERP\backups\db
# MYSQLDUMP_PATH=C:\Program Files\MySQL\MySQL Server 8.0\bin\mysqldump.exe
# MYSQL_PATH=C:\Program Files\MySQL\MySQL Server 8.0\bin\mysql.exe
# BACKUP_JOB_LOCK_STALE_MS=1800000

# --- Optional: feature flags (default OFF) -----------------------------------

# FEATURE_MONTHLY_PLANNING=false
# FEATURE_PLANNING_DRIVEN_PROCUREMENT=false

# --- Optional: operational tuning --------------------------------------------

# PERF_LOG=false
# PERF_SLOW_MS=700
# RM_ISSUE_TOLERANCE_PERCENT=
# RM_ISSUE_TOLERANCE_MIN_KG=

# --- Development / test only (do NOT enable in production) -------------------

# TESTING_MODE_RELAXED_TAX_FIELDS=false
# INTEGRATION_DATABASE_URL=
# TALLY_IMPORT_DEBUG=0
# DEBUG_STORE_RS=0

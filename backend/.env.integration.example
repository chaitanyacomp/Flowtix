# Optional: copy to .env.integration (gitignored) for integration-test DB settings.
# Create an empty database first, e.g. CREATE DATABASE mini_erp_integration;
#
# Then run (from backend/):
#   npm run test:integration:prepare   # applies committed migrations (prisma migrate deploy)
#   npm run test:integration:db        # runs the DB-backed integration suite

# Preferred: strict prepare/run scripts read TEST_DATABASE_URL and require it to
# differ from DATABASE_URL. Must point at a dedicated, disposable test database.
TEST_DATABASE_URL="mysql://erp:erp1234@localhost:3306/mini_erp_integration"

# Legacy fallback still accepted by the raw skipped integration tests; prefer TEST_DATABASE_URL.
INTEGRATION_DATABASE_URL="mysql://erp:erp1234@localhost:3306/mini_erp_integration"
ERP_RUN_DB_INTEGRATION=1
